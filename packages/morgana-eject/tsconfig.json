{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@studiomorgana/sdk": ["../sdk/src/index.ts"],
      "@studiomorgana/sdk-compile": ["../sdk-compile/src/index.ts"]
    }
  },
  "include": ["src"]
}
