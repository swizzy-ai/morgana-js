{
  "name": "@morgana/agents",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent loop for Morgana: Nanoagent runtime plus providers, action tools, and ctx.agents construction.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwizzyAI/morgana-js.git",
    "directory": "packages/morgana-agents"
  },
  "homepage": "https://github.com/SwizzyAI/morgana-js/tree/main/packages/morgana-agents#readme",
  "bugs": {
    "url": "https://github.com/SwizzyAI/morgana-js/issues"
  },
  "keywords": [
    "morgana",
    "agents",
    "llm",
    "ai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hbbio/nanoagent": "^0.1.3"
  },
  "peerDependencies": {
    "@morgana/sdk": "^0.3.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@morgana/sdk": "workspace:^",
    "@types/node": "^22.14.0",
    "tsup": "^8.4.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}