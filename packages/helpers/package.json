{
  "name": "@studiomorgana/helpers",
  "version": "0.3.0",
  "type": "module",
  "description": "Morgana helpers: write UI in plain English — create, place, make, set, show, fill, when, go, theme — plus bricks (repeat, cells, segmented, rows, onlyWhile) so page code never writes a loop.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwizzyAI/morgana-js.git",
    "directory": "packages/helpers"
  },
  "homepage": "https://github.com/SwizzyAI/morgana-js/tree/main/packages/helpers#readme",
  "bugs": {
    "url": "https://github.com/SwizzyAI/morgana-js/issues"
  },
  "keywords": [
    "morgana",
    "helpers",
    "ui",
    "fluent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vocabulary.json": "./vocabulary.json"
  },
  "files": [
    "dist",
    "vocabulary.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/vocabulary.mjs && tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@studiomorgana/points": "workspace:^"
  },
  "devDependencies": {
    "@studiomorgana/sdk": "workspace:^",
    "tsup": "^8.4.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
