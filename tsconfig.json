{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "paths": {
      "@studiomorgana/sdk": ["./packages/sdk/src/index.ts"],
      "@studiomorgana/sdk/*": ["./packages/sdk/src/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // This config is shared base options + workspace path aliases — NOT a
  // project. Every package and example has its own tsconfig with a tight
  // `include`, and CI typechecks those. Without these excludes, any tool
  // that runs `tsc -p tsconfig.json` at the root (editors, agents) sweeps
  // in files that are deliberately not part of any checked project:
  //   examples/            — checked by examples/*/tsconfig.json instead
  //   packages/morgana-server — the private worker; not in this repo's
  //                             workspace and its deps are not installed
  //   */dist               — build output, never typecheck input
  "exclude": ["node_modules", "examples", "packages/morgana-server", "**/dist"]
}